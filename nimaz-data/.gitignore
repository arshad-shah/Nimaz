# §2 — the three databases. Exactly one of them is text, and none of them is git's.
vault/
.build/
out/

__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# Generated by `nz init` from the vault. The round trip proves these could be
# committed (§11.4) — that is a deliberate decision about 125 MB of text in the
# Android repo, not a default. Remove these lines when it is made.
data/collections/*/
data/keys/
data/genesis.json
data/schema.sql
