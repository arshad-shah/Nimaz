<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Nimaz" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Nimaz.PostSplash</item>
    </style>

    <style name="Theme.Nimaz.PostSplash" parent="android:Theme.Material.Light.NoActionBar">
