<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera for AR Qibla -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration for Tasbih -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Schedule exact alarms for prayer notifications -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Boot receiver for rescheduling alarms -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Battery optimization exemption for reliable notifications -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Wake lock for alarms -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Internet for fetching Quran audio (optional) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Nearby Connections (device-to-device sync) -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />

    <application
        android:name=".NimazApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Nimaz"
        tools:targetApi="34">

        <!-- Disable default WorkManager initializer to use Hilt -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Nimaz">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recovery only: re-arms the prayer alarms and the widget tick after a restart or
             an app update. The alarm actions that used to be filtered here are delivered by
             PrayerAlarmReceiver below, through explicit PendingIntents that need no filter.

             MY_PACKAGE_REPLACED is what carries an existing install across that move: every
             alarm armed by an older build names BootReceiver, and after the split those alarms
             resolve a receiver that no longer handles their action. The OS takes the app out of
             the stopped state to deliver this one, so the re-arm happens within seconds of the
             update rather than waiting for the user to open the app.

             The two QUICKBOOT_POWERON actions are what some OEM fast-boot implementations send
             in place of BOOT_COMPLETED. BootReceiver has always had code for them; it had no
             filter, so it never ran. -->
        <receiver
            android:name=".core.util.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Every alarm the app arms: prayer notifications and pre-reminders, the nightly
             summary, the Friday reminder, the khatam nudge, the worship reminders and the
             midnight reschedule. All arrive as explicit PendingIntents, so this needs a
             declaration and no intent-filter. -->
        <receiver
            android:name=".core.util.PrayerAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- The three audio foreground services, and the FOREGROUND_SERVICE* permissions they
             need, are declared by :core:audio's own manifest and merged in from there. -->

        <!-- FCM engagement announcements: foreground messages are handled by the
             service (Home banner, no tray notification); backgrounded messages are
             posted by the OS on the channel/icon/color declared below. -->
        <service
            android:name=".data.announcement.NimazMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="nimaz_announcements" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_nimaz" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/teal_700" />

        <!-- FileProvider for sharing exported files (e.g. prayer-times PDF) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
