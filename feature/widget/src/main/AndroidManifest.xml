            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hijri_date_widget_info" />
        </receiver>
        <!-- Prayer Tracker Widget -->
        <receiver
            android:name="com.arshadshah.nimaz.widget.prayertracker.PrayerTrackerWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_prayer_tracker_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/prayer_tracker_widget_info" />
        </receiver>
        <!-- Hijri Calendar Widget -->
        <receiver
            android:name="com.arshadshah.nimaz.widget.hijricalendar.HijriCalendarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_hijri_calendar_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hijri_calendar_widget_info" />
        </receiver>
        <!-- Khatam Widget -->
        <receiver
            android:name="com.arshadshah.nimaz.widget.khatam.KhatamWidgetReceiver"
            android:exported="true"
            android:label="@string/khatam_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/khatam_widget_info" />
        </receiver>
        <!-- Widget per-minute countdown tick receiver -->
        <receiver
            android:name="com.arshadshah.nimaz.widget.WidgetTickReceiver"
            android:exported="false" />
    </application>

</manifest>
