<?xml version="1.0" encoding="utf-8"?>
<!--
  targetCellWidth/Height, maxResizeWidth/Height and previewLayout are API 31+.
  Older platforms ignore them and fall back to minWidth/minHeight and
  initialLayout, both declared below, so the widget still sizes and renders
  correctly on minSdk 29. tools:targetApi marks that as deliberate.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="s"
    android:minWidth="250dp"
    android:minHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:minResizeWidth="180dp"
    android:minResizeHeight="60dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="120dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/glance_default_loading"
    android:previewLayout="@layout/widget_prayer_times_preview"
    android:description="@string/widget_prayer_times_description"
    android:widgetCategory="home_screen" />
