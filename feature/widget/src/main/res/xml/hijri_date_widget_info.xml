<?xml version="1.0" encoding="utf-8"?>
<!--
  targetCellWidth/Height, maxResizeWidth/Height and previewLayout are API 31+.
  Older platforms ignore them and fall back to minWidth/minHeight and
  initialLayout, both declared below, so the widget still sizes and renders
  correctly on minSdk 29. tools:targetApi marks that as deliberate.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="s"
    android:minWidth="110dp"
    android:minHeight="120dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:minResizeWidth="80dp"
    android:minResizeHeight="100dp"
    android:maxResizeWidth="200dp"
    android:maxResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="3600000"
    android:initialLayout="@layout/glance_default_loading"
    android:previewLayout="@layout/widget_hijri_date_preview"
    android:description="@string/widget_hijri_date_description"
    android:widgetCategory="home_screen" />
